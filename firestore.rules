rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated()
        && request.auth.uid == userId;
    }

    function isBabyMember(babyId) {
      return isAuthenticated()
        && exists(
          /databases/$(database)/documents/babies/$(babyId)/members/$(request.auth.uid)
        );
    }

    function isBabyOwner(babyId) {
      return isBabyMember(babyId)
        && get(
          /databases/$(database)/documents/babies/$(babyId)/members/$(request.auth.uid)
        ).data.role == 'owner';
    }

    function isRemovingCaregiver(
      babyId,
      memberId
    ) {
      return isAuthenticated()
        && request.auth.uid != memberId
        && isBabyOwner(
          babyId
        )
        && exists(
          /databases/$(database)/documents/babies/$(babyId)/members/$(memberId)
        )
        && get(
          /databases/$(database)/documents/babies/$(babyId)/members/$(memberId)
        ).data.role == 'caregiver'
        && !existsAfter(
          /databases/$(database)/documents/babies/$(babyId)/members/$(memberId)
        );
    }

    function isValidAccessRemovedNotification(
      data,
      userId,
      notificationId
    ) {
      return data.keys().hasOnly([
          'type',
          'babyId',
          'babyName',
          'createdAt',
          'readAt'
        ])
        && data.keys().hasAll([
          'type',
          'babyId',
          'babyName',
          'createdAt',
          'readAt'
        ])
        && data.type
          == 'baby-access-removed'
        && data.babyId is string
        && data.babyId.size() > 0
        && data.babyId.size() <= 128
        && notificationId
          == 'baby-access-removed-' + data.babyId
        && data.babyName is string
        && data.babyName.size() >= 1
        && data.babyName.size() <= 80
        && data.babyName
          == get(
            /databases/$(database)/documents/babies/$(data.babyId)
          ).data.name
        && data.createdAt is timestamp
        && data.createdAt == request.time
        && data.readAt == null
        && isRemovingCaregiver(
          data.babyId,
          userId
        );
    }

    function hasAccessRemovedNotificationAfter(
      babyId,
      memberId
    ) {
      let notificationId =
        'baby-access-removed-' + babyId;

      return existsAfter(
          /databases/$(database)/documents/users/$(memberId)/notifications/$(notificationId)
        )
        && getAfter(
          /databases/$(database)/documents/users/$(memberId)/notifications/$(notificationId)
        ).data.type
          == 'baby-access-removed'
        && getAfter(
          /databases/$(database)/documents/users/$(memberId)/notifications/$(notificationId)
        ).data.babyId
          == babyId
        && getAfter(
          /databases/$(database)/documents/users/$(memberId)/notifications/$(notificationId)
        ).data.babyName
          == get(
            /databases/$(database)/documents/babies/$(babyId)
          ).data.name
        && getAfter(
          /databases/$(database)/documents/users/$(memberId)/notifications/$(notificationId)
        ).data.createdAt
          == request.time
        && getAfter(
          /databases/$(database)/documents/users/$(memberId)/notifications/$(notificationId)
        ).data.readAt
          == null;
    }

    function isValidInviteId(inviteId) {
      return inviteId is string
        && inviteId.size() >= 32
        && inviteId.size() <= 128;
    }

    function isAcceptingInviteForBaby(
      babyId,
      memberId
    ) {
      let invite =
        get(
          /databases/$(database)/documents/babyInvites/$(request.resource.data.inviteId)
        ).data;

      let acceptedInvite =
        getAfter(
          /databases/$(database)/documents/babyInvites/$(request.resource.data.inviteId)
        ).data;

      let profile =
        getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data;

      return isAuthenticated()
        && memberId
          == request.auth.uid
        && 'inviteId'
          in request.resource.data
        && isValidInviteId(
          request.resource.data.inviteId
        )

        /*
         * Estado anterior do convite.
         */
        && invite.status
          == 'pending'
        && invite.babyId
          == babyId
        && invite.createdByUid
          != request.auth.uid
        && invite.expiresAt
          > request.time

        /*
         * Estado final obrigatório no
         * mesmo batch/transaction.
         */
        && acceptedInvite.status
          == 'accepted'
        && acceptedInvite.acceptedByUid
          == request.auth.uid
        && acceptedInvite.acceptedAt
          == request.time
        && acceptedInvite.babyId
          == babyId

        /*
         * O perfil deve passar a apontar
         * para o mesmo bebê no mesmo lote.
         */
        && profile.activeBabyId
          == babyId;
    }

    function isCreatingInitialOwner(
      babyId,
      memberId
    ) {
      return isAuthenticated()
        && memberId == request.auth.uid
        && request.resource.data.role == 'owner'
        && getAfter(
          /databases/$(database)/documents/babies/$(babyId)
        ).data.createdByUid == request.auth.uid;
    }

    function isValidTimestamp(value) {
      return value is int
        && value >= 0;
    }

    function isNullableTimestamp(value) {
      return value == null
        || isValidTimestamp(value);
    }

    function isValidSide(value) {
      return value == null
        || value == 'left'
        || value == 'right';
    }

    function isValidProfile(data) {
      return data.keys().hasOnly([
          'caregiverName',
          'babyName',
          'babyBirthDate',
          'consentGiven',
          'consentAt',
          'createdAt',
          'updatedAt',
          'legacyMigrationVersion',
          'recordsMigrationVersion',
          'recordsMigratedAt',
          'activeBabyId',
          'babyMigrationVersion',
          'babyMigratedAt'
        ])
        && data.keys().hasAll([
          'caregiverName',
          'babyName',
          'babyBirthDate',
          'consentGiven',
          'consentAt'
        ])
        && data.caregiverName is string
        && data.caregiverName.size() <= 80
        && data.babyName is string
        && data.babyName.size() <= 80
        && data.babyBirthDate is string
        && data.consentGiven is bool
        && (
          data.consentAt == null
          || data.consentAt is string
        )
        && (
          !('createdAt' in data)
          || data.createdAt is string
        )
        && (
          !('updatedAt' in data)
          || data.updatedAt is string
        )
        && (
          !('legacyMigrationVersion' in data)
          || data.legacyMigrationVersion is int
        )
        && (
          !('recordsMigrationVersion' in data)
          || data.recordsMigrationVersion is int
        )
        && (
          !('recordsMigratedAt' in data)
          || data.recordsMigratedAt is string
        )
        && (
          !('activeBabyId' in data)
          || (
            data.activeBabyId is string
            && data.activeBabyId.size() > 0
            && data.activeBabyId.size() <= 128
          )
        )
        && (
          !('babyMigrationVersion' in data)
          || (
            data.babyMigrationVersion is int
            && data.babyMigrationVersion == 1
          )
        )
        && (
          !('babyMigratedAt' in data)
          || data.babyMigratedAt is string
        );
    }

    function isValidBaby(data) {
      return data.keys().hasOnly([
          'name',
          'birthDate',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'name',
          'birthDate',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 80
        && data.birthDate is string
        && data.birthDate.size() == 10
        && data.createdByUid is string
        && data.createdByUid.size() > 0
        && data.createdAt is string
        && data.updatedAt is string;
    }

    function isValidBabyMember(data) {
      return data.keys().hasOnly([
          'role',
          'joinedAt',
          'inviteId',
          'caregiverName'
        ])
        && data.keys().hasAll([
          'role',
          'joinedAt'
        ])
        && (
          data.role == 'owner'
          || data.role == 'caregiver'
        )
        && data.joinedAt is string
        && (
          !('inviteId' in data)
          || isValidInviteId(
            data.inviteId
          )
        )
        && (
          !('caregiverName' in data)
          || (
            data.caregiverName is string
            && data.caregiverName.size() >= 1
            && data.caregiverName.size() <= 80
          )
        );
    }

    function isValidPendingInvite(data) {
      return data.keys().hasOnly([
          'babyId',
          'createdByUid',
          'createdAt',
          'expiresAt',
          'status'
        ])
        && data.keys().hasAll([
          'babyId',
          'createdByUid',
          'createdAt',
          'expiresAt',
          'status'
        ])
        && data.babyId is string
        && data.babyId.size() > 0
        && data.babyId.size() <= 128
        && data.createdByUid is string
        && data.createdByUid == request.auth.uid
        && data.createdAt is timestamp
        && data.expiresAt is timestamp
        && data.status == 'pending'
        && data.createdAt <= request.time
        && data.expiresAt > request.time
        && data.expiresAt
          <= request.time
            + duration.value(
              24,
              'h'
            );
    }

    function isValidInviteAcceptance(
      inviteId
    ) {
      let acceptedMember =
        getAfter(
          /databases/$(database)/documents/babies/$(resource.data.babyId)/members/$(request.auth.uid)
        ).data;

      return isAuthenticated()
        && isValidInviteId(
          inviteId
        )
        && resource.data.status
          == 'pending'
        && resource.data.expiresAt
          > request.time
        && request.auth.uid
          != resource.data.createdByUid
        && request.resource.data.keys().hasOnly([
          'babyId',
          'createdByUid',
          'createdAt',
          'expiresAt',
          'status',
          'acceptedByUid',
          'acceptedAt'
        ])
        && request.resource.data.keys().hasAll([
          'babyId',
          'createdByUid',
          'createdAt',
          'expiresAt',
          'status',
          'acceptedByUid',
          'acceptedAt'
        ])

        /*
         * Dados originais do convite
         * permanecem imutáveis.
         */
        && request.resource.data.babyId
          == resource.data.babyId
        && request.resource.data.createdByUid
          == resource.data.createdByUid
        && request.resource.data.createdAt
          == resource.data.createdAt
        && request.resource.data.expiresAt
          == resource.data.expiresAt

        /*
         * Única transição válida:
         * pending -> accepted.
         */
        && request.resource.data.status
          == 'accepted'
        && request.resource.data.acceptedByUid
          == request.auth.uid
        && request.resource.data.acceptedAt
          == request.time

        /*
         * O responsável precisa ser criado
         * no mesmo batch/transaction.
         */
        && acceptedMember.role
          == 'caregiver'
        && acceptedMember.inviteId
          == inviteId;
    }

    function isValidFeeding(data, feedingId) {
      return data.keys().hasOnly([
          'id',
          'startedAt',
          'endedAt',
          'side',
          'periods'
        ])
        && data.keys().hasAll([
          'id',
          'startedAt',
          'endedAt',
          'side',
          'periods'
        ])
        && data.id is string
        && data.id == feedingId
        && isValidTimestamp(data.startedAt)
        && isNullableTimestamp(data.endedAt)
        && (
          data.endedAt == null
          || data.endedAt >= data.startedAt
        )
        && isValidSide(data.side)
        && (
          data.periods == null
          || data.periods is list
        );
    }

    function isValidSleep(data, sleepId) {
      return data.keys().hasOnly([
          'id',
          'startedAt',
          'endedAt'
        ])
        && data.keys().hasAll([
          'id',
          'startedAt',
          'endedAt'
        ])
        && data.id is string
        && data.id == sleepId
        && isValidTimestamp(data.startedAt)
        && isNullableTimestamp(data.endedAt)
        && (
          data.endedAt == null
          || data.endedAt >= data.startedAt
        );
    }

    function isValidDiaper(data, diaperId) {
      return data.keys().hasOnly([
          'id',
          'type',
          'recordedAt'
        ])
        && data.keys().hasAll([
          'id',
          'type',
          'recordedAt'
        ])
        && data.id is string
        && data.id == diaperId
        && (
          data.type == 'wet'
          || data.type == 'dirty'
          || data.type == 'both'
        )
        && isValidTimestamp(data.recordedAt);
    }

    /*
     * Estrutura legada.
     *
     * Continua ativa durante a migração
     * para a estrutura baseada em bebê.
     */
    match /users/{userId} {
      allow read:
        if isOwner(userId);

      allow create, update:
        if isOwner(userId)
        && isValidProfile(
          request.resource.data
        );

      allow delete:
        if isOwner(userId);

      match /notifications/{notificationId} {
        /*
         * Somente o próprio usuário pode
         * consultar suas notificações.
         */
        allow read:
          if isOwner(
            userId
          );

        /*
         * O proprietário de um bebê pode
         * criar ou renovar exclusivamente
         * a notificação de acesso removido,
         * desde que o vínculo do responsável
         * seja apagado no mesmo batch.
         */
        allow create:
          if isValidAccessRemovedNotification(
            request.resource.data,
            userId,
            notificationId
          );

        /*
         * Há dois tipos de atualização:
         *
         * 1. o proprietário remove novamente
         *    um responsável que havia sido
         *    convidado outra vez;
         *
         * 2. o próprio destinatário marca
         *    a mensagem como lida.
         */
        allow update:
          if (
            isValidAccessRemovedNotification(
              request.resource.data,
              userId,
              notificationId
            )
          )
          ||
          (
            isOwner(
              userId
            )
            && request.resource.data.keys().hasOnly([
              'type',
              'babyId',
              'babyName',
              'createdAt',
              'readAt'
            ])
            && request.resource.data.keys().hasAll([
              'type',
              'babyId',
              'babyName',
              'createdAt',
              'readAt'
            ])
            && notificationId
              == 'baby-access-removed-' + resource.data.babyId
            && resource.data.type
              == 'baby-access-removed'
            && request.resource.data.type
              == resource.data.type
            && request.resource.data.babyId
              == resource.data.babyId
            && request.resource.data.babyName
              == resource.data.babyName
            && request.resource.data.createdAt
              == resource.data.createdAt
            && resource.data.readAt
              == null
            && request.resource.data.readAt
              == request.time
          );

        allow delete:
          if false;
      }

      match /feedings/{feedingId} {
        allow read:
          if isOwner(userId);

        allow create, update:
          if isOwner(userId)
          && isValidFeeding(
            request.resource.data,
            feedingId
          );

        allow delete:
          if isOwner(userId);
      }

      match /sleeps/{sleepId} {
        allow read:
          if isOwner(userId);

        allow create, update:
          if isOwner(userId)
          && isValidSleep(
            request.resource.data,
            sleepId
          );

        allow delete:
          if isOwner(userId);
      }

      match /diapers/{diaperId} {
        allow read:
          if isOwner(userId);

        allow create, update:
          if isOwner(userId)
          && isValidDiaper(
            request.resource.data,
            diaperId
          );

        allow delete:
          if isOwner(userId);
      }
    }

    /*
     * Nova estrutura compartilhada.
     */

    /*
     * Convites de compartilhamento.
     *
     * O ID do documento é o token secreto.
     * Convites não podem ser listados.
     */
    match /babyInvites/{inviteId} {
      /*
       * Quem possui o token pode consultar
       * um convite pendente, desde que esteja
       * autenticado.
       *
       * Depois de consumido, somente quem
       * criou ou aceitou pode consultá-lo.
       */
      allow get:
        if isAuthenticated()
        && (
          resource.data.status
            == 'pending'
          ||
          resource.data.createdByUid
            == request.auth.uid
          ||
          (
            resource.data.status
              == 'accepted'
            && resource.data.acceptedByUid
              == request.auth.uid
          )
        );

      /*
       * Impede enumeração de convites.
       */
      allow list:
        if false;

      allow create:
        if isAuthenticated()
        && isValidInviteId(
          inviteId
        )
        && isValidPendingInvite(
          request.resource.data
        )
        && isBabyOwner(
          request.resource.data.babyId
        );

      /*
       * A única atualização permitida é
       * pending -> accepted.
       */
      allow update:
        if isValidInviteAcceptance(
          inviteId
        );

      /*
       * O proprietário pode revogar um
       * convite ainda não utilizado.
       */
      allow delete:
        if isAuthenticated()
        && resource.data.status
          == 'pending'
        && isBabyOwner(
          resource.data.babyId
        );
    }

    match /babies/{babyId} {
      allow create:
        if isAuthenticated()
        && isValidBaby(
          request.resource.data
        )
        && request.resource.data.createdByUid
          == request.auth.uid;

      allow read:
        if isBabyMember(
          babyId
        );

      allow update:
        if isBabyOwner(
          babyId
        )
        && isValidBaby(
          request.resource.data
        )
        && request.resource.data.createdByUid
          == resource.data.createdByUid
        && request.resource.data.createdAt
          == resource.data.createdAt;

      /*
       * Exclusão completa do bebê ainda
       * não faz parte deste MVP.
       */
      allow delete:
        if false;

      match /members/{memberId} {
        allow read:
          if isBabyMember(
            babyId
          );

        allow create:
          if isValidBabyMember(
            request.resource.data
          )
          && (
            /*
             * Aceitação através de convite.
             *
             * Novos responsáveis que entram
             * via convite precisam registrar
             * o nome no próprio vínculo.
             */
            (
              request.resource.data.role
                == 'caregiver'
              && 'inviteId'
                in request.resource.data
              && 'caregiverName'
                in request.resource.data
              && isAcceptingInviteForBaby(
                babyId,
                memberId
              )
            )

            ||

            /*
             * Primeiro proprietário durante
             * a criação do bebê.
             */
            (
              !(
                'inviteId'
                in request.resource.data
              )
              && isCreatingInitialOwner(
                babyId,
                memberId
              )
            )

            ||

            /*
             * O proprietário também pode
             * adicionar um cuidador diretamente.
             */
            (
              !(
                'inviteId'
                in request.resource.data
              )
              && isBabyOwner(
                babyId
              )
              && request.resource.data.role
                == 'caregiver'
            )
          );

        /*
         * Por enquanto o papel não é alterado.
         * Um responsável pode ser removido
         * e convidado novamente.
         */
        allow update:
          if false;

        allow delete:
          if (
            isBabyOwner(
              babyId
            )
            && memberId != request.auth.uid
            && resource.data.role == 'caregiver'
            && hasAccessRemovedNotificationAfter(
              babyId,
              memberId
            )
          )
          ||
          (
            memberId == request.auth.uid
            && resource.data.role == 'caregiver'
          );
      }

      match /feedings/{feedingId} {
        allow read:
          if isBabyMember(
            babyId
          );

        allow create, update:
          if isBabyMember(
            babyId
          )
          && isValidFeeding(
            request.resource.data,
            feedingId
          );

        allow delete:
          if isBabyMember(
            babyId
          );
      }

      match /sleeps/{sleepId} {
        allow read:
          if isBabyMember(
            babyId
          );

        allow create, update:
          if isBabyMember(
            babyId
          )
          && isValidSleep(
            request.resource.data,
            sleepId
          );

        allow delete:
          if isBabyMember(
            babyId
          );
      }

      match /diapers/{diaperId} {
        allow read:
          if isBabyMember(
            babyId
          );

        allow create, update:
          if isBabyMember(
            babyId
          )
          && isValidDiaper(
            request.resource.data,
            diaperId
          );

        allow delete:
          if isBabyMember(
            babyId
          );
      }
    }
  }
}